# Copy to .env and fill with real values. Never commit .env.
# This file is placeholders only — do not paste live keys here.

# ── API KEYS ─────────────────────────────────────────────────────────
QWEN_API_KEY=your-modelscope-qwen-key-here
OPENAI_API_KEY=sk-your-openai-key-here
AIRTABLE_API_KEY=patYourAirtableTokenHere
AIRTABLE_BASE_ID=appYourBaseIdHere
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── EMAIL SENDING (outgoing proposal emails) ─────────────────────────
GMAIL_ADDRESS=you@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_RECIPIENTS=reviewer1@example.com,reviewer2@example.com
EMAIL_SENDER=bd-agent@example.com
RESEND_API_KEY=

# ── SCHEDULER / MONITORING ───────────────────────────────────────────
CHECK_INTERVAL_HOURS=6
HEALTHCHECK_URL=
MAX_OPPORTUNITIES_PER_RUN=15
FULL_DRAFT_FOR_WATCH=true
ANTHROPIC_TIMEOUT_SECONDS=180
ANTHROPIC_MAX_RETRIES=2
DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=60
# Maximum accepted source document size. Keep finite because source URLs are untrusted.
MAX_DOCUMENT_BYTES=26214400
MAX_DOWNLOAD_REDIRECTS=5
DOCUMENT_DOWNLOAD_MAX_RETRIES=2

# ── ASSORTIS / ICA DAILY NEWSLETTER (IMAP) ───────────────────────────
# Often a different mailbox than GMAIL_ADDRESS (which is for sending).
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USERNAME=newsletter-inbox@example.com
IMAP_PASSWORD=your-imap-password
IMAP_FOLDER=INBOX
IMAP_NEWSLETTER_SENDER=icaworld.net
IMAP_NEWSLETTER_SUBJECT=ICA Daily Newsletter
IMAP_LOOKBACK_DAYS=3
MAX_GDRIVE_FILES=25
MAX_EXTRACTED_TEXT_CHARS=120000
MAX_DOCUMENT_UNCOMPRESSED_BYTES=104857600
MAX_RUN_COST_USD=25
PLAYWRIGHT_TIMEOUT_MS=45000
PLAYWRIGHT_JS_HEAP_MB=512

# Optional. PostgREST cannot run DDL. Needed only to apply SQL migrations from CLI.
# DATABASE_URL=postgresql://postgres.your-ref:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_REGION=eu-west-1
# SUPABASE_ACCESS_TOKEN=

# ── DASHBOARD (dashboard/ — Render web service + background worker) ──────────
# Google OAuth 2.0 web client from Google Cloud Console. Authorised redirect
# URI must be exactly: ${PUBLIC_BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the deployed web service (no trailing slash), e.g.
# https://cortech-bd-web.onrender.com. Local: http://127.0.0.1:8000
PUBLIC_BASE_URL=
# Signs the session cookie. No default — unset disables login. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DASHBOARD_SESSION_SECRET=
# Access: verified Google email must end in @AUTH_ALLOWED_DOMAIN, OR appear in
# AUTH_ALLOWED_EMAILS (comma-separated full addresses, default empty).
AUTH_ALLOWED_DOMAIN=cortechconsultinggroup.com
AUTH_ALLOWED_EMAILS=
# Set to false only for local http://127.0.0.1 development.
DASHBOARD_COOKIE_SECURE=true
DASHBOARD_POLL_MS=15000
DASHBOARD_TRIGGERS_ENABLED=true
# Aggregate cap across ALL dashboard-triggered runs in the trailing window —
# enforced by the worker before a job starts. The per-run MAX_RUN_COST_USD
# above still applies to each run. 0 blocks every dashboard run.
DASHBOARD_AGGREGATE_CAP_USD=100
DASHBOARD_AGGREGATE_WINDOW_HOURS=24
DASHBOARD_BULK_MAX=40
DASHBOARD_HEARTBEAT_SECONDS=10
DASHBOARD_WORKER_POLL_SECONDS=5
DASHBOARD_WORKER_LEASE_SECONDS=3600

