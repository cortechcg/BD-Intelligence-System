# ── ASSORTIS / ICA DAILY NEWSLETTER (IMAP) ───────────────────────────
# This is very likely a DIFFERENT mailbox/credential pair than
# GMAIL_ADDRESS / GMAIL_APP_PASSWORD, which are used for *sending*
# proposal emails, not reading the inbox that receives this newsletter.
# Do not assume they're interchangeable.
IMAP_HOST=mail.cortechcgl.com
IMAP_PORT=993
IMAP_USERNAME=hassan.abdi@cortechcgl.com
IMAP_PASSWORD=HassanINFO25@
IMAP_FOLDER=INBOX
# Matched against the sender ADDRESS or its display name, case-insensitively.
# Use the address/domain, not the display name: the From header has shipped
# as both "Info ICA World" and a bare "info@icaworld.net", and only the
# address is stable.
IMAP_NEWSLETTER_SENDER=icaworld.net
IMAP_NEWSLETTER_SUBJECT=ICA Daily Newsletter
# Days of newsletters re-read on every check. The agent never uses the
# \Seen flag (the inbox is shared with people who read it themselves), so
# this window is what makes a missed run self-healing. Re-reading costs
# nothing — Supabase dedup blocks anything already processed.
IMAP_LOOKBACK_DAYS=3
