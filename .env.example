# Copy to .env and fill with real values. Never commit .env.
# This file is placeholders only — do not paste live keys here.

# ── API KEYS ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENAI_API_KEY=sk-your-openai-key-here
AIRTABLE_API_KEY=patYourAirtableTokenHere
AIRTABLE_BASE_ID=appYourBaseIdHere
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── EMAIL SENDING (outgoing proposal emails) ─────────────────────────
GMAIL_ADDRESS=you@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_RECIPIENTS=reviewer1@example.com,reviewer2@example.com
EMAIL_SENDER=bd-agent@example.com
RESEND_API_KEY=

# ── SCHEDULER / MONITORING ───────────────────────────────────────────
CHECK_INTERVAL_HOURS=6
HEALTHCHECK_URL=
MAX_OPPORTUNITIES_PER_RUN=15
FULL_DRAFT_FOR_WATCH=true
ANTHROPIC_TIMEOUT_SECONDS=180
ANTHROPIC_MAX_RETRIES=2
DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=60
# Maximum accepted source document size. Keep finite because source URLs are untrusted.
MAX_DOCUMENT_BYTES=26214400
MAX_DOWNLOAD_REDIRECTS=5
DOCUMENT_DOWNLOAD_MAX_RETRIES=2

# ── ASSORTIS / ICA DAILY NEWSLETTER (IMAP) ───────────────────────────
# Often a different mailbox than GMAIL_ADDRESS (which is for sending).
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USERNAME=newsletter-inbox@example.com
IMAP_PASSWORD=your-imap-password
IMAP_FOLDER=INBOX
IMAP_NEWSLETTER_SENDER=icaworld.net
IMAP_NEWSLETTER_SUBJECT=ICA Daily Newsletter
IMAP_LOOKBACK_DAYS=3
MAX_GDRIVE_FILES=25
MAX_EXTRACTED_TEXT_CHARS=120000
MAX_DOCUMENT_UNCOMPRESSED_BYTES=104857600
